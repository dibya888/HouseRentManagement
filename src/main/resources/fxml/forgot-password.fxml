<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.rent.controller.ForgotPasswordController"
      spacing="16"
      prefWidth="540"
      styleClass="popup-root"
      stylesheets="@/css/popups.css">

    <ImageView fitWidth="80" preserveRatio="true">
        <image>
            <Image url="@/images/app-logo.png" />
        </image>
    </ImageView>

    <Label text="🔑 Reset Password"
           styleClass="popup-title"
           maxWidth="Infinity"
           alignment="CENTER"/>

    <VBox spacing="12" styleClass="popup-card">

        <Label text="Enter your username and recovery PIN to reset your password."
               wrapText="true"
               styleClass="popup-subtitle"/>

        <GridPane hgap="14" vgap="12">

            <Label text="Username:"/>
            <TextField fx:id="usernameField"
                       GridPane.columnIndex="1"
                       prefWidth="250"/>

            <Label text="Recovery PIN:" GridPane.rowIndex="1"/>
            <PasswordField fx:id="recoveryPinField"
                           GridPane.rowIndex="1"
                           GridPane.columnIndex="1"
                           prefWidth="250"/>

            <Label text="New Password:" GridPane.rowIndex="2"/>
            <PasswordField fx:id="newPasswordField"
                           GridPane.rowIndex="2"
                           GridPane.columnIndex="1"
                           prefWidth="250"/>

            <Label text="Confirm Password:" GridPane.rowIndex="3"/>
            <PasswordField fx:id="confirmPasswordField"
                           GridPane.rowIndex="3"
                           GridPane.columnIndex="1"
                           prefWidth="250"
                           onAction="#resetPassword"/>

        </GridPane>

        <Label text="If you lost your password and recovery PIN, use emergency keys, restore backup, or factory reset."
               wrapText="true"
               styleClass="popup-subtitle"/>

    </VBox>

    <VBox spacing="12">

        <!-- Primary action -->
        <Button text="Reset with Recovery PIN"
                onAction="#resetPassword"
                maxWidth="Infinity"
                styleClass="popup-primary-btn"/>

        <!-- Alternative recovery options -->
        <HBox spacing="10" alignment="CENTER">
            <Button text="Use Emergency Key"
                    onAction="#openEmergencyKeyReset"
                    prefWidth="210"
                    styleClass="popup-purple-btn"/>

            <Button text="Factory Reset"
                    onAction="#factoryReset"
                    prefWidth="210"
                    styleClass="popup-danger-btn"/>
        </HBox>

        <!-- Cancel -->
        <Button text="Cancel"
                onAction="#close"
                maxWidth="Infinity"
                styleClass="popup-secondary-btn"/>

    </VBox>

</VBox>
