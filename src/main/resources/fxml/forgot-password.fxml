<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.rent.controller.ForgotPasswordController"
      spacing="16"
      prefWidth="540"
      style="-fx-padding:24; -fx-background-color:#f8fafc;">

    <Label text="🔑 Reset Password"
           style="-fx-font-size:22px; -fx-font-weight:bold;"
           maxWidth="Infinity"
           alignment="CENTER"/>

    <VBox spacing="12"
          style="-fx-background-color:white; -fx-padding:18; -fx-background-radius:12;">

        <Label text="Enter your username and recovery PIN to reset your password."
               wrapText="true"
               style="-fx-text-fill:#374151;"/>

        <GridPane hgap="14" vgap="12">

            <Label text="Username:"/>
            <TextField fx:id="usernameField"
                       GridPane.columnIndex="1"
                       prefWidth="250"/>

            <Label text="Recovery PIN:" GridPane.rowIndex="1"/>
            <PasswordField fx:id="recoveryPinField"
                           GridPane.rowIndex="1"
                           GridPane.columnIndex="1"
                           prefWidth="250"/>

            <Label text="New Password:" GridPane.rowIndex="2"/>
            <PasswordField fx:id="newPasswordField"
                           GridPane.rowIndex="2"
                           GridPane.columnIndex="1"
                           prefWidth="250"/>

            <Label text="Confirm Password:" GridPane.rowIndex="3"/>
            <PasswordField fx:id="confirmPasswordField"
                           GridPane.rowIndex="3"
                           GridPane.columnIndex="1"
                           prefWidth="250"
                           onAction="#resetPassword"/>

        </GridPane>

        <Label text="If you lost your password and recovery PIN, use emergency keys, restore backup, or factory reset."
               wrapText="true"
               style="-fx-text-fill:#6b7280; -fx-font-size:12px;"/>

    </VBox>

    <VBox spacing="12">

        <!-- Primary action -->
        <Button text="Reset with Recovery PIN"
                onAction="#resetPassword"
                maxWidth="Infinity"
                style="-fx-background-color:#2563eb;
                   -fx-text-fill:white;
                   -fx-font-weight:bold;
                   -fx-padding:9 14;"/>

        <!-- Alternative recovery options -->
        <HBox spacing="10" alignment="CENTER">
            <Button text="Use Emergency Key"
                    onAction="#openEmergencyKeyReset"
                    prefWidth="210"
                    style="-fx-background-color:#7c3aed;
                       -fx-text-fill:white;
                       -fx-font-weight:bold;
                       -fx-padding:8 12;"/>

            <Button text="Factory Reset"
                    onAction="#factoryReset"
                    prefWidth="210"
                    style="-fx-background-color:#dc2626;
                       -fx-text-fill:white;
                       -fx-font-weight:bold;
                       -fx-padding:8 12;"/>
        </HBox>

        <!-- Cancel -->
        <Button text="Cancel"
                onAction="#close"
                maxWidth="Infinity"
                style="-fx-background-color:#e5e7eb;
                   -fx-text-fill:#111827;
                   -fx-font-weight:bold;
                   -fx-padding:8 12;"/>

    </VBox>

</VBox>