<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.rent.controller.FlatController"
      spacing="16"
      style="-fx-padding:20; -fx-background-color:#ffffff;">

    <!-- Header -->
    <HBox alignment="CENTER_LEFT" spacing="12">
        <Label text="🏢 Flat Management"
               style="-fx-font-size:20px; -fx-font-weight:bold;"/>

        <Region HBox.hgrow="ALWAYS"/>

        <Button text="➕ Add Flat"
                onAction="#handleAddFlat"
                style="
                    -fx-background-color:#2563eb;
                    -fx-text-fill:white;
                    -fx-font-weight:bold;
                    -fx-padding:6 14;
                "/>
    </HBox>

    <Separator/>

    <!-- Flats Table -->
    <TableView fx:id="flatTable">

        <columns>

            <!-- Identity -->
            <TableColumn fx:id="colFlatNo" text="Flat No" minWidth="90"/>

            <!-- ✅ NEW: Property -->
            <TableColumn fx:id="colProperty" text="Property" minWidth="160"/>

            <TableColumn fx:id="colMeterNo" text="Meter No" minWidth="110"/>

            <!-- Structure -->
            <TableColumn fx:id="colBeds" text="Beds" prefWidth="60"/>
            <TableColumn fx:id="colBaths" text="Baths" prefWidth="60"/>
            <TableColumn fx:id="colKitchen" text="Kitchen" prefWidth="70"/>
            <TableColumn fx:id="colBalcony" text="Balcony" prefWidth="70"/>
            <TableColumn fx:id="colDining" text="Dining" prefWidth="70"/>
            <TableColumn fx:id="colLiving" text="Living" prefWidth="70"/>

            <!-- Financial & Status -->
            <TableColumn fx:id="colRent" text="Rent" prefWidth="90"/>
            <TableColumn fx:id="colStatus" text="Status" prefWidth="90"/>

            <!-- Actions -->
            <TableColumn fx:id="colAction" text="Actions" prefWidth="160"/>

        </columns>

    </TableView>

</VBox>
