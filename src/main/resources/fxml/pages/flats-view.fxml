<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.rent.controller.FlatController"
      spacing="15"
      style="-fx-padding:20;">

    <!-- Header -->
    <HBox alignment="CENTER_LEFT" spacing="10">
        <Label text="🏢 Flat Management"
               style="-fx-font-size:20px; -fx-font-weight:bold;"/>

        <Region HBox.hgrow="ALWAYS"/>

        <Button text="➕ Add Flat"
                onAction="#handleAddFlat"
                style="-fx-background-color:#2563eb; -fx-text-fill:white;"/>
    </HBox>

    <!-- Flats Table -->
    <TableView fx:id="flatTable">

        <columns>
            <TableColumn fx:id="colFlatNo" text="Flat No" prefWidth="90"/>
            <TableColumn fx:id="colBeds" text="Beds" prefWidth="60"/>
            <TableColumn fx:id="colBaths" text="Baths" prefWidth="60"/>
            <TableColumn fx:id="colKitchen" text="Kitchen" prefWidth="80"/>
            <TableColumn fx:id="colBalcony" text="Balcony" prefWidth="80"/>
            <TableColumn fx:id="colDining" text="Dining" prefWidth="80"/>
            <TableColumn fx:id="colLiving" text="Living" prefWidth="80"/>
            <TableColumn fx:id="colRent" text="Rent" prefWidth="90"/>
            <TableColumn fx:id="colStatus" text="Status" prefWidth="100"/>
            <TableColumn fx:id="colAction" text="Action" prefWidth="200"/>
        </columns>

    </TableView>

</VBox>