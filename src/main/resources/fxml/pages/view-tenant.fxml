<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.*?>

<BorderPane xmlns="http://javafx.com/javafx/8"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.rent.controller.ViewTenantController"
            styleClass="popup-root"
            stylesheets="@/css/popups.css">

    <!-- Header -->
    <top>
        <HBox alignment="CENTER_LEFT"
              spacing="10"
              style="-fx-padding:20; -fx-background-color:white;">
            <Label text="👤 Tenant Details"
                   styleClass="popup-title"/>
        </HBox>
    </top>

    <!-- Scrollable Content -->
    <center>
        <ScrollPane fitToWidth="true"
                    vbarPolicy="AS_NEEDED"
                    hbarPolicy="NEVER"
                    style="-fx-background-color:transparent;">

            <content>
                <VBox spacing="16"
                      style="-fx-padding:20; -fx-background-color:transparent;">

                    <!-- Personal Info Card -->
                    <VBox spacing="10" styleClass="popup-card">
                        <Label text="Personal Information"
                               styleClass="popup-section-title"/>

                        <GridPane hgap="16" vgap="10">
                            <Label text="Name:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                            <Label fx:id="nameLabel" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                            <Label text="Phone:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                            <Label fx:id="phoneLabel" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                            <Label text="Email:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                            <Label fx:id="emailLabel" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

                            <Label text="NID:" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                            <Label fx:id="nidLabel" GridPane.rowIndex="3" GridPane.columnIndex="1"/>
                        </GridPane>
                    </VBox>

                    <!-- Flat & Rent Card -->
                    <VBox spacing="10" styleClass="popup-card">
                        <Label text="Flat &amp; Rent"
                               styleClass="popup-section-title"/>

                        <GridPane hgap="16" vgap="10">
                            <Label text="Flat No:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                            <Label fx:id="flatLabel" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                            <Label text="Rent:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                            <Label fx:id="rentLabel" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                            <Label text="Address:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                            <Label fx:id="addressLabel" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

                            <Label text="Meter No:" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                            <Label fx:id="meterLabel" GridPane.rowIndex="3" GridPane.columnIndex="1"/>
                        </GridPane>
                    </VBox>

                    <!-- Tenancy & Deposit Card -->
                    <VBox spacing="10" styleClass="popup-card">

                        <Label text="Tenancy &amp; Security Deposit"
                               styleClass="popup-section-title"/>

                        <GridPane hgap="16" vgap="10">

                            <Label text="Status:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                            <Label fx:id="statusLabel" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                            <Label text="Move In Date:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                            <Label fx:id="moveInDateLabel" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                            <Label text="Security Deposit:" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
                            <Label fx:id="securityDepositLabel" GridPane.rowIndex="4" GridPane.columnIndex="1"/>

                            <Label text="Deposit Date:" GridPane.rowIndex="5" GridPane.columnIndex="0"/>
                            <Label fx:id="securityDepositDateLabel" GridPane.rowIndex="5" GridPane.columnIndex="1"/>

                            <Label text="Deposit Note:" GridPane.rowIndex="6" GridPane.columnIndex="0"/>
                            <Label fx:id="securityDepositNoteLabel"
                                   wrapText="true"
                                   GridPane.rowIndex="6"
                                   GridPane.columnIndex="1"/>

                        </GridPane>
                    </VBox>

                    <!-- Move Out Info Card -->
                    <VBox fx:id="moveOutInfoBox"
                          spacing="10"
                          styleClass="popup-card">

                        <Label text="Move Out Information"
                               styleClass="popup-section-title"/>

                        <GridPane hgap="16" vgap="10">
                            <Label text="Move Out Date:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                            <Label fx:id="moveOutDateLabel" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                            <Label text="Move Out Reason:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                            <Label fx:id="moveOutReasonLabel"
                                   wrapText="true"
                                   GridPane.rowIndex="1"
                                   GridPane.columnIndex="1"/>
                        </GridPane>
                    </VBox>

                    <!-- Documents Card -->
                    <VBox spacing="10"
                          fx:id="documentsBox"
                          styleClass="popup-card">

                        <Label text="Documents"
                               styleClass="popup-section-title"/>

                        <!-- NID -->
                        <VBox fx:id="nidBox" spacing="4">
                            <Label fx:id="nidPathLabel"/>
                            <Button fx:id="openNidBtn"
                                    text="Open NID File"
                                    onAction="#openNidFile"
                                    styleClass="popup-secondary-btn"/>
                        </VBox>

                        <!-- Document -->
                        <VBox fx:id="docBox" spacing="4">
                            <Label fx:id="docPathLabel"/>
                            <Button fx:id="openDocBtn"
                                    text="Open Document"
                                    onAction="#openDocFile"
                                    styleClass="popup-secondary-btn"/>
                        </VBox>

                    </VBox>

                </VBox>
            </content>
        </ScrollPane>
    </center>

    <!-- Footer -->
    <bottom>
        <HBox alignment="CENTER_RIGHT"
              style="-fx-padding:20;">
            <Button text="Close"
                    onAction="#close"
                    styleClass="popup-secondary-btn"/>
        </HBox>
    </bottom>

</BorderPane>
