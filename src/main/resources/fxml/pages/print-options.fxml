<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.rent.controller.PrintOptionsController"
      spacing="14"
      style="-fx-padding:20; -fx-background-color:white; -fx-background-radius:12;">

    <Label text="🧾 Print Receipt"
           style="-fx-font-size:18px; -fx-font-weight:bold;"/>

    <Label text="Choose what to include:"
           style="-fx-text-fill:#6b7280;"/>

    <VBox spacing="8">
        <CheckBox fx:id="propertyNameCheck" text="Include Property Name"/>
        <CheckBox fx:id="propertyAddressCheck" text="Include Property Address"/>
    </VBox>

    <Separator/>

    <HBox spacing="10" alignment="CENTER_RIGHT">
        <Button text="Cancel"
                onAction="#close"
                style="-fx-background-color:#e5e7eb; -fx-text-fill:#111827; -fx-padding:6 12;"/>

        <Button text="Print"
                onAction="#print"
                style="-fx-background-color:#2563eb; -fx-text-fill:white; -fx-font-weight:bold; -fx-padding:6 14;"/>
    </HBox>

</VBox>