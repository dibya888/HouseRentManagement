<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.rent.controller.PrintOptionsController"
      spacing="14"
      styleClass="popup-root"
      stylesheets="@/css/popups.css">

    <Label text="🧾 Print Receipt"
           styleClass="popup-title"/>

    <VBox spacing="12" styleClass="popup-card">

        <Label text="Choose what to include:"
               styleClass="popup-subtitle"/>

        <VBox spacing="8">
            <CheckBox fx:id="propertyNameCheck" text="Include Property Name"/>
            <CheckBox fx:id="propertyAddressCheck" text="Include Property Address"/>
        </VBox>
    </VBox>

    <HBox spacing="10" alignment="CENTER_RIGHT">
        <Button text="Cancel"
                onAction="#close"
                styleClass="popup-secondary-btn"/>

        <Button text="Print"
                onAction="#print"
                styleClass="popup-primary-btn"/>
    </HBox>

</VBox>
