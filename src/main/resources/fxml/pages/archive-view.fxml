<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.rent.controller.ArchiveController"
            style="-fx-background-color:#f4f6f7;">

    <center>
        <VBox spacing="14" style="-fx-padding:20;">

            <!-- Header -->
            <HBox spacing="10" alignment="CENTER_LEFT">
                <Label text="🗃 Rent Archive"
                       style="-fx-font-size:22px; -fx-font-weight:bold;"/>

                <Region HBox.hgrow="ALWAYS"/>

                <Button text="🔄 Refresh"
                        onAction="#loadArchive"
                        style="-fx-background-color:#2563eb; -fx-text-fill:white; -fx-font-weight:bold;"/>
            </HBox>

            <!-- Filters -->
            <HBox spacing="10" alignment="CENTER_LEFT"
                  style="-fx-background-color:white; -fx-padding:12; -fx-background-radius:10;">

                <TextField fx:id="searchField"
                           promptText="🔍 Search tenant, flat, phone..."
                           onKeyReleased="#applyFilters"
                           prefWidth="280"/>

                <Label text="Month:"/>
                <DatePicker fx:id="monthPicker" prefWidth="145"/>

                <Label text="From:"/>
                <DatePicker fx:id="fromDatePicker" prefWidth="145"/>

                <Label text="To:"/>
                <DatePicker fx:id="toDatePicker" prefWidth="145"/>

                <Button text="Clear"
                        onAction="#clearFilters"
                        style="-fx-background-color:#e5e7eb; -fx-font-weight:bold;"/>
            </HBox>

            <!-- Archive Table -->
            <TableView fx:id="archiveTable">
                <columns>
                    <TableColumn fx:id="colFlatNo" text="Flat No" prefWidth="90"/>
                    <TableColumn fx:id="colTenantName" text="Tenant" prefWidth="140"/>
                    <TableColumn fx:id="colPhone" text="Phone" prefWidth="120"/>
                    <TableColumn fx:id="colBillMonth" text="Bill Month" prefWidth="110"/>
                    <TableColumn fx:id="colPaymentDate" text="Payment Date" prefWidth="120"/>
                    <TableColumn fx:id="colTotal" text="Total" prefWidth="90"/>
                    <TableColumn fx:id="colStatus" text="Status" prefWidth="90"/>
                    <TableColumn fx:id="colAction" text="Action" prefWidth="320"/>
                </columns>
            </TableView>

        </VBox>
    </center>

</BorderPane>
