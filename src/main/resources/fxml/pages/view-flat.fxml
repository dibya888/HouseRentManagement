<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.rent.controller.ViewFlatController"
      spacing="14"
      style="-fx-padding:20;">

    <Label fx:id="titleLabel"
           style="-fx-font-size:18px; -fx-font-weight:bold;"/>

    <Separator/>

    <GridPane hgap="12" vgap="10">

        <Label text="Meter No:" GridPane.rowIndex="0"/><Label fx:id="meterLabel" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

        <Label text="Bedrooms:" GridPane.rowIndex="1"/><Label fx:id="bedLabel" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
        <Label text="Bathrooms:" GridPane.rowIndex="2"/><Label fx:id="bathLabel" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
        <Label text="Kitchens:" GridPane.rowIndex="3"/><Label fx:id="kitchenLabel" GridPane.rowIndex="3" GridPane.columnIndex="1"/>
        <Label text="Balconies:" GridPane.rowIndex="4"/><Label fx:id="balconyLabel" GridPane.rowIndex="4" GridPane.columnIndex="1"/>
        <Label text="Dining Rooms:" GridPane.rowIndex="5"/><Label fx:id="diningLabel" GridPane.rowIndex="5" GridPane.columnIndex="1"/>
        <Label text="Living Rooms:" GridPane.rowIndex="6"/><Label fx:id="livingLabel" GridPane.rowIndex="6" GridPane.columnIndex="1"/>

        <Label text="Rent:" GridPane.rowIndex="7"/><Label fx:id="rentLabel" GridPane.rowIndex="7" GridPane.columnIndex="1"/>
        <Label text="Status:" GridPane.rowIndex="8"/><Label fx:id="statusLabel" GridPane.rowIndex="8" GridPane.columnIndex="1"/>

    </GridPane>

    <Separator/>

    <HBox alignment="CENTER_RIGHT">
        <Button text="Close" onAction="#close"/>
    </HBox>

</VBox>
