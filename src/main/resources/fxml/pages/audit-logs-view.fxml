<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.rent.controller.AuditLogsController"
            style="-fx-background-color:#f4f6f7;">

    <center>
        <VBox spacing="14" style="-fx-padding:20;">

            <!-- Header -->
            <HBox spacing="10" alignment="CENTER_LEFT">
                <Label text="📜 Audit Logs"
                       style="-fx-font-size:22px; -fx-font-weight:bold;"/>

                <Region HBox.hgrow="ALWAYS"/>

                <Button text="🔄 Refresh"
                        onAction="#loadLogs"
                        style="-fx-background-color:#2563eb; -fx-text-fill:white; -fx-font-weight:bold;"/>
            </HBox>

            <!-- Filters -->
            <HBox spacing="10" alignment="CENTER_LEFT"
                  style="-fx-background-color:white; -fx-padding:12; -fx-background-radius:10;">

                <TextField fx:id="searchField"
                           promptText="🔍 Search action, user, details..."
                           onKeyReleased="#applyFilters"
                           prefWidth="300"/>

                <Label text="Action:"/>
                <ComboBox fx:id="actionCombo"
                          prefWidth="190"/>

                <Label text="From:"/>
                <DatePicker fx:id="fromDatePicker"
                            prefWidth="145"/>

                <Label text="To:"/>
                <DatePicker fx:id="toDatePicker"
                            prefWidth="145"/>

                <Button text="Clear"
                        onAction="#clearFilters"
                        style="-fx-background-color:#e5e7eb; -fx-font-weight:bold;"/>
            </HBox>

            <!-- Table -->
            <TableView fx:id="auditTable">
                <columns>
                    <TableColumn fx:id="colCreatedAt" text="Date / Time" prefWidth="160"/>
                    <TableColumn fx:id="colUsername" text="User" prefWidth="120"/>
                    <TableColumn fx:id="colActionType" text="Action" prefWidth="190"/>
                    <TableColumn fx:id="colDetails" text="Details" prefWidth="520"/>
                    <TableColumn fx:id="colAction" text="Action" prefWidth="100"/>
                </columns>
            </TableView>

        </VBox>
    </center>

</BorderPane>