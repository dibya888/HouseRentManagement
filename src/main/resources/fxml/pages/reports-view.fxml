<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import com.rent.util.MonthYearPicker?>

<ScrollPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.rent.controller.ReportsController"
            fitToWidth="true"
            style="-fx-background-color:#f4f6f7;">

    <content>
        <StackPane style="-fx-padding:20; -fx-background-color:#f4f6f7;">
            <VBox spacing="20" maxWidth="1180">

                <!-- Header -->
                <HBox alignment="CENTER_LEFT" spacing="10">
                    <Label text="📈 Reports"
                           styleClass="dashboard-title"/>

                    <Region HBox.hgrow="ALWAYS"/>

                    <Button text="🖨 Print"
                            onAction="#printReport"
                            styleClass="reports-action-btn"
                            style="-fx-background-color:#2563eb; -fx-text-fill:white;"/>

                    <Button text="📊 Export Excel"
                            onAction="#exportExcel"
                            styleClass="reports-action-btn"
                            style="-fx-background-color:#16a34a; -fx-text-fill:white;"/>

                    <Button text="📄 Export PDF"
                            onAction="#exportPdf"
                            styleClass="reports-action-btn"
                            style="-fx-background-color:#dc2626; -fx-text-fill:white;"/>
                </HBox>

                <!-- Filter Area -->
                <VBox spacing="10" styleClass="reports-filter-bar">

                    <Label text="FILTERS" styleClass="reports-section-label"/>

                    <HBox spacing="16" alignment="CENTER_LEFT">

                        <VBox spacing="4">
                            <Label text="Report Type" styleClass="reports-card-label"/>
                            <ComboBox fx:id="reportTypeCombo" prefWidth="190"/>
                        </VBox>

                        <VBox spacing="4">
                            <Label text="Month" styleClass="reports-card-label"/>
                            <MonthYearPicker fx:id="monthPicker" prefWidth="150"/>
                        </VBox>

                        <VBox spacing="4">
                            <Label text="From" styleClass="reports-card-label"/>
                            <DatePicker fx:id="fromDatePicker" prefWidth="150"/>
                        </VBox>

                        <VBox spacing="4">
                            <Label text="To" styleClass="reports-card-label"/>
                            <DatePicker fx:id="toDatePicker" prefWidth="150"/>
                        </VBox>

                        <Region HBox.hgrow="ALWAYS"/>

                        <Button text="Generate"
                                onAction="#generateReport"
                                styleClass="reports-action-btn"
                                style="-fx-background-color:#111827; -fx-text-fill:white;"/>

                        <Button text="Clear"
                                onAction="#clearFilters"
                                styleClass="reports-action-btn"
                                style="-fx-background-color:#e5e7eb; -fx-text-fill:#374151;"/>

                    </HBox>
                </VBox>

                <!-- Summary Cards -->
                <VBox spacing="10">
                    <Label text="INCOME &amp; OCCUPANCY SUMMARY" styleClass="reports-section-label"/>

                    <FlowPane hgap="14" vgap="14">

                        <VBox styleClass="dashboard-panel" minWidth="220">
                            <Label text="Total Income" styleClass="reports-card-label"/>
                            <Label fx:id="totalIncomeLabel" text="৳ 0" styleClass="reports-card-value"/>
                        </VBox>

                        <VBox styleClass="dashboard-panel" minWidth="220">
                            <Label text="This Month Income" styleClass="reports-card-label"/>
                            <Label fx:id="monthIncomeLabel" text="৳ 0" styleClass="reports-card-value"/>
                        </VBox>

                        <VBox styleClass="dashboard-panel" minWidth="220">
                            <Label text="This Year Income" styleClass="reports-card-label"/>
                            <Label fx:id="yearIncomeLabel" text="৳ 0" styleClass="reports-card-value"/>
                        </VBox>

                        <VBox styleClass="dashboard-panel" minWidth="220">
                            <Label text="Total Due" styleClass="reports-card-label"/>
                            <Label fx:id="totalDueLabel" text="৳ 0" styleClass="reports-card-value"/>
                        </VBox>

                        <VBox styleClass="dashboard-panel" minWidth="220">
                            <Label text="Total Flats" styleClass="reports-card-label"/>
                            <Label fx:id="totalFlatsLabel" text="0" styleClass="reports-card-value"/>
                        </VBox>

                        <VBox styleClass="dashboard-panel" minWidth="220">
                            <Label text="Occupied Flats" styleClass="reports-card-label"/>
                            <Label fx:id="occupiedFlatsLabel" text="0" styleClass="reports-card-value"/>
                        </VBox>

                        <VBox styleClass="dashboard-panel" minWidth="220">
                            <Label text="Available Flats" styleClass="reports-card-label"/>
                            <Label fx:id="availableFlatsLabel" text="0" styleClass="reports-card-value"/>
                        </VBox>

                        <VBox styleClass="dashboard-panel" minWidth="220">
                            <Label text="Total Tenants" styleClass="reports-card-label"/>
                            <Label fx:id="totalTenantsLabel" text="0" styleClass="reports-card-value"/>
                        </VBox>

                    </FlowPane>
                </VBox>

                <VBox spacing="10">
                    <Label text="REPAIR &amp; PROFIT SUMMARY" styleClass="reports-section-label"/>

                    <FlowPane hgap="14" vgap="14">

                        <VBox styleClass="dashboard-panel" minWidth="220">
                            <Label text="Total Repair Cost" styleClass="reports-card-label"/>
                            <Label fx:id="totalRepairLabel" text="৳ 0" styleClass="reports-card-value"/>
                        </VBox>

                        <VBox styleClass="dashboard-panel" minWidth="220">
                            <Label text="This Month Repair" styleClass="reports-card-label"/>
                            <Label fx:id="monthRepairLabel" text="৳ 0" styleClass="reports-card-value"/>
                        </VBox>

                        <VBox styleClass="dashboard-panel" minWidth="220">
                            <Label text="This Year Repair" styleClass="reports-card-label"/>
                            <Label fx:id="yearRepairLabel" text="৳ 0" styleClass="reports-card-value"/>
                        </VBox>

                        <VBox styleClass="dashboard-panel" minWidth="220">
                            <Label text="Owner Paid Repairs" styleClass="reports-card-label"/>
                            <Label fx:id="ownerRepairLabel" text="৳ 0" styleClass="reports-card-value"/>
                        </VBox>

                        <VBox styleClass="dashboard-panel" minWidth="220">
                            <Label text="Tenant Paid Repairs" styleClass="reports-card-label"/>
                            <Label fx:id="tenantRepairLabel" text="৳ 0" styleClass="reports-card-value"/>
                        </VBox>

                        <VBox styleClass="dashboard-panel" minWidth="220" style="-fx-border-color:#16a34a; -fx-border-width:0 0 0 4; -fx-border-radius:14;">
                            <Label text="Net Income" styleClass="reports-card-label"/>
                            <Label fx:id="netProfitLabel" text="৳ 0" styleClass="reports-card-value"/>
                        </VBox>

                    </FlowPane>
                </VBox>

                <VBox spacing="10">
                    <Label text="UTILITY BILLS SUMMARY" styleClass="reports-section-label"/>

                    <FlowPane hgap="14" vgap="14">

                        <VBox styleClass="dashboard-panel" minWidth="220">
                            <Label text="Total Utility Bills" styleClass="reports-card-label"/>
                            <Label fx:id="totalUtilityLabel" text="৳ 0" styleClass="reports-card-value"/>
                        </VBox>

                        <VBox styleClass="dashboard-panel" minWidth="220">
                            <Label text="This Month Utility Bills" styleClass="reports-card-label"/>
                            <Label fx:id="monthUtilityLabel" text="৳ 0" styleClass="reports-card-value"/>
                        </VBox>

                        <VBox styleClass="dashboard-panel" minWidth="220">
                            <Label text="This Year Utility Bills" styleClass="reports-card-label"/>
                            <Label fx:id="yearUtilityLabel" text="৳ 0" styleClass="reports-card-value"/>
                        </VBox>

                        <VBox styleClass="dashboard-panel" minWidth="280">
                            <Label text="Utility Breakdown" styleClass="reports-card-label"/>
                            <Label fx:id="utilityBreakdownLabel" text="৳ 0"
                                   style="-fx-font-size:13px; -fx-font-weight:bold; -fx-text-fill:#111827;"
                                   wrapText="true"/>
                        </VBox>

                    </FlowPane>
                </VBox>

                <!-- Report Table -->
                <VBox spacing="10">
                    <Label text="DETAILED REPORT" styleClass="reports-section-label"/>

                    <TableView fx:id="reportTable"
                               styleClass="dashboard-table"
                               prefHeight="420"
                               VBox.vgrow="ALWAYS">
                        <columns>
                            <TableColumn fx:id="colTitle" text="Title" prefWidth="180"/>
                            <TableColumn fx:id="colMonth" text="Month" prefWidth="100"/>
                            <TableColumn fx:id="colDate" text="Date" prefWidth="110"/>
                            <TableColumn fx:id="colFlatNo" text="Flat No" prefWidth="100"/>
                            <TableColumn fx:id="colTenant" text="Tenant" prefWidth="160"/>
                            <TableColumn fx:id="colTotal" text="Total" prefWidth="120"/>
                            <TableColumn fx:id="colExtra" text="Info" prefWidth="120" visible="false"/>
                            <TableColumn fx:id="colPaid" text="Paid" prefWidth="120"/>
                            <TableColumn fx:id="colDue" text="Due" prefWidth="120"/>
                            <TableColumn fx:id="colStatus" text="Status" prefWidth="120"/>
                        </columns>
                        <placeholder>
                            <Label text="No report data for the selected filters."
                                   style="-fx-text-fill:#9ca3af; -fx-font-size:13px;"/>
                        </placeholder>
                    </TableView>
                </VBox>

            </VBox>
        </StackPane>
    </content>

</ScrollPane>