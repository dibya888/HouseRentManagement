<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.rent.controller.BillsController"
            style="-fx-background-color:#f4f6f7;">

    <center>
        <VBox spacing="18" style="-fx-padding:20;">

            <!-- Header -->
            <Label text="📌 Billing Defaults"
                   style="-fx-font-size:20px; -fx-font-weight:bold;"/>

            <!-- Card -->
            <VBox spacing="16"
                  style="-fx-background-color:white;
                         -fx-padding:20;
                         -fx-background-radius:10;">

                <Label text="These values will be applied to all future billing"
                       style="-fx-text-fill:#4b5563;"/>

                <GridPane hgap="16" vgap="14">

                    <Label text="Electricity Bill:"/>
                    <TextField fx:id="electricityField" GridPane.columnIndex="1"/>

                    <Label text="Gas Bill:" GridPane.rowIndex="1"/>
                    <TextField fx:id="gasField"
                               GridPane.rowIndex="1"
                               GridPane.columnIndex="1"/>

                    <Label text="Water Bill:" GridPane.rowIndex="2"/>
                    <TextField fx:id="waterField"
                               GridPane.rowIndex="2"
                               GridPane.columnIndex="1"/>

                    <Label text="Rent Due Day (1-28):" GridPane.rowIndex="3"/>
                    <TextField fx:id="dueDayField"
                               GridPane.rowIndex="3"
                               GridPane.columnIndex="1"/>

                </GridPane>

            </VBox>

            <!-- Footer -->
            <HBox alignment="CENTER_RIGHT" spacing="10">
                <Button text="Close" onAction="#close"/>
                <Button text="Save Defaults"
                        onAction="#save"
                        style="-fx-background-color:#16a34a;
                               -fx-text-fill:white;
                               -fx-font-weight:bold;"/>
            </HBox>

        </VBox>
    </center>
</BorderPane>