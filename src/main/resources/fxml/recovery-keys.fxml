<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.rent.controller.RecoveryKeysController"
      spacing="16"
      prefWidth="560"
      prefHeight="540"
      styleClass="popup-root"
      stylesheets="@/css/popups.css">

    <ImageView fitWidth="80" preserveRatio="true">
        <image>
            <Image url="@/images/app-logo.png" />
        </image>
    </ImageView>

    <Label text="🗝 Emergency Recovery Keys"
           styleClass="popup-title"
           maxWidth="Infinity"
           alignment="CENTER"/>

    <ScrollPane fitToWidth="true"
                VBox.vgrow="ALWAYS"
                style="-fx-background-color:transparent; -fx-background:transparent;">
        <content>
            <VBox spacing="10" styleClass="popup-card">

                <Label text="Generate 10 one-time emergency recovery keys."
                       styleClass="popup-section-title"/>

                <Label text="These keys are shown only once. Save or print them now. Each key can reset your password one time."
                       wrapText="true"
                       styleClass="popup-subtitle"/>

                <Label fx:id="remainingKeysLabel"
                       text="Unused keys: 0"
                       style="-fx-font-weight:bold; -fx-text-fill:#374151;"/>

                <TextArea fx:id="keysArea"
                          editable="false"
                          wrapText="true"
                          prefRowCount="12"
                          promptText="Generated keys will appear here."/>

            </VBox>
        </content>
    </ScrollPane>

    <HBox spacing="10" alignment="CENTER_RIGHT">
        <Button text="Close"
                onAction="#close"
                styleClass="popup-secondary-btn"/>

        <Button text="Generate 10 Keys"
                onAction="#generateKeys"
                styleClass="popup-purple-btn"/>

        <Button text="Save as PDF"
                onAction="#saveAsPdf"
                styleClass="popup-primary-btn"/>
    </HBox>

</VBox>
