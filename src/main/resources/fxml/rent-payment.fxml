<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.rent.controller.RentPaymentController"
      spacing="16"
      minWidth="520"
      prefWidth="560"
      prefHeight="640"
      maxWidth="600"
      styleClass="popup-root"
      stylesheets="@/css/popups.css">

    <!-- HEADER -->
    <Label text="💳 Rent Payment"
           styleClass="popup-title"
           alignment="CENTER"
           maxWidth="Infinity"/>

    <ScrollPane fitToWidth="true"
                VBox.vgrow="ALWAYS"
                style="-fx-background-color:transparent; -fx-background:transparent;">
        <content>
            <VBox spacing="16">

                <!-- INFO CARD -->
                <VBox spacing="8" styleClass="popup-card">
                    <Label fx:id="tenantNameLabel" style="-fx-font-size:14px;"/>
                    <Label fx:id="flatLabel"/>
                    <Label fx:id="monthLabel"/>
                    <Label fx:id="flatRentLabel" style="-fx-font-weight:bold;"/>
                </VBox>

                <!-- PAYMENT FORM -->
                <VBox spacing="12" styleClass="popup-card">

                    <GridPane hgap="14" vgap="10">
                        <Label text="Electricity:"/>
                        <TextField fx:id="electricityField" GridPane.columnIndex="1"/>

                        <Label text="Water:" GridPane.rowIndex="1"/>
                        <TextField fx:id="waterField" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                        <Label text="Gas:" GridPane.rowIndex="2"/>
                        <TextField fx:id="gasField" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

                        <Label text="Other Bills:" GridPane.rowIndex="3"/>
                        <TextField fx:id="otherField" GridPane.rowIndex="3" GridPane.columnIndex="1"/>

                        <Label text="Fine:" GridPane.rowIndex="4"/>
                        <TextField fx:id="fineField" GridPane.rowIndex="4" GridPane.columnIndex="1"/>

                        <Label text="Discount:" GridPane.rowIndex="5"/>
                        <TextField fx:id="discountField" GridPane.rowIndex="5" GridPane.columnIndex="1"/>

                        <Separator GridPane.rowIndex="6" GridPane.columnSpan="2"/>

                        <Label text="Total:" GridPane.rowIndex="7" style="-fx-font-weight:bold;"/>
                        <Label fx:id="totalLabel" GridPane.rowIndex="7" GridPane.columnIndex="1"
                               style="-fx-font-weight:bold;"/>

                        <Label text="Paid Amount:" GridPane.rowIndex="8"/>
                        <TextField fx:id="paidAmountField"
                                   GridPane.rowIndex="8"
                                   GridPane.columnIndex="1"
                                   editable="false"
                                   styleClass="popup-readonly-field"/>

                        <Label text="Payment Date:" GridPane.rowIndex="9"/>
                        <DatePicker fx:id="paymentDatePicker"
                                    GridPane.rowIndex="9"
                                    GridPane.columnIndex="1"/>
                    </GridPane>
                </VBox>
            </VBox>
        </content>
    </ScrollPane>

    <!-- ACTIONS -->
    <HBox spacing="10" alignment="CENTER_RIGHT">
        <Button text="Cancel" onAction="#close" styleClass="popup-secondary-btn"/>
        <Button text="Save Payment"
                onAction="#save"
                styleClass="popup-success-btn"/>
    </HBox>

</VBox>
