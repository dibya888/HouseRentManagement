<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.rent.controller.RentPaymentController"
      spacing="12"
      style="-fx-padding:20;">

    <Label fx:id="titleLabel"
           style="-fx-font-size:18px; -fx-font-weight:bold;"/>

    <Separator/>

    <GridPane hgap="12" vgap="10">
        <Label text="Electricity:" GridPane.rowIndex="0"/><TextField fx:id="electricityField" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
        <Label text="Water:" GridPane.rowIndex="1"/><TextField fx:id="waterField" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
        <Label text="Gas:" GridPane.rowIndex="2"/><TextField fx:id="gasField" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

        <Label text="Other Bills:" GridPane.rowIndex="3"/><TextField fx:id="otherField" GridPane.rowIndex="3" GridPane.columnIndex="1"/>
        <Label text="Fine:" GridPane.rowIndex="4"/><TextField fx:id="fineField" GridPane.rowIndex="4" GridPane.columnIndex="1"/>
        <Label text="Discount:" GridPane.rowIndex="5"/><TextField fx:id="discountField" GridPane.rowIndex="5" GridPane.columnIndex="1"/>

        <Label text="Paid Amount:" GridPane.rowIndex="6"/><TextField fx:id="paidAmountField" GridPane.rowIndex="6" GridPane.columnIndex="1"/>
        <Label text="Payment Date:" GridPane.rowIndex="7"/><DatePicker fx:id="paymentDatePicker" GridPane.rowIndex="7" GridPane.columnIndex="1"/>
    </GridPane>

    <Separator/>

    <HBox spacing="10" alignment="CENTER_RIGHT">
        <Button text="Cancel" onAction="#close"/>
        <Button text="Save Payment" onAction="#save"
                style="-fx-background-color:#16a34a; -fx-text-fill:white; -fx-font-weight:bold;"/>
    </HBox>

</VBox>