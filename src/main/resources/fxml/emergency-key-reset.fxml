<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.rent.controller.EmergencyKeyResetController"
      spacing="16"
      prefWidth="500"
      prefHeight="540"
      styleClass="popup-root"
      stylesheets="@/css/popups.css">

    <ImageView fitWidth="80" preserveRatio="true">
        <image>
            <Image url="@/images/app-logo.png" />
        </image>
    </ImageView>

    <Label text="🗝 Reset Password with Emergency Key"
           styleClass="popup-title"
           maxWidth="Infinity"
           alignment="CENTER"/>

    <ScrollPane fitToWidth="true"
                VBox.vgrow="ALWAYS"
                style="-fx-background-color:transparent; -fx-background:transparent;">
        <content>
            <VBox spacing="12" styleClass="popup-card">

                <Label text="Use one unused emergency recovery key to reset your password."
                       wrapText="true"
                       styleClass="popup-subtitle"/>

                <GridPane hgap="14" vgap="12">

                    <Label text="Username:"/>
                    <TextField fx:id="usernameField"
                               GridPane.columnIndex="1"
                               prefWidth="270"/>

                    <Label text="Emergency Key:" GridPane.rowIndex="1"/>
                    <TextField fx:id="emergencyKeyField"
                               GridPane.rowIndex="1"
                               GridPane.columnIndex="1"
                               prefWidth="270"
                               promptText="XXXX-XXXX-XXXX"/>

                    <Label text="New Password:" GridPane.rowIndex="2"/>
                    <PasswordField fx:id="newPasswordField"
                                   GridPane.rowIndex="2"
                                   GridPane.columnIndex="1"
                                   prefWidth="270"/>

                    <Label text="Confirm Password:" GridPane.rowIndex="3"/>
                    <PasswordField fx:id="confirmPasswordField"
                                   GridPane.rowIndex="3"
                                   GridPane.columnIndex="1"
                                   prefWidth="270"
                                   onAction="#resetPassword"/>

                </GridPane>

                <Label text="Each emergency key can be used only once. After use, it becomes invalid."
                       wrapText="true"
                       styleClass="popup-subtitle"/>

            </VBox>
        </content>
    </ScrollPane>

    <HBox spacing="10" alignment="CENTER_RIGHT">
        <Button text="Cancel"
                onAction="#close"
                styleClass="popup-secondary-btn"/>

        <Button text="Reset Password"
                onAction="#resetPassword"
                styleClass="popup-purple-btn"/>
    </HBox>

</VBox>
