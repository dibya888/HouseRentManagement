<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.rent.controller.ChangePasswordController"
      spacing="16"
      prefWidth="440"
      style="-fx-padding:24; -fx-background-color:#f8fafc;">

    <Label text="🔐 Change Password"
           style="-fx-font-size:22px; -fx-font-weight:bold;"
           maxWidth="Infinity"
           alignment="CENTER"/>

    <VBox spacing="12"
          style="-fx-background-color:white; -fx-padding:18; -fx-background-radius:12;">

        <GridPane hgap="14" vgap="12">

            <Label text="Current Password:"/>
            <PasswordField fx:id="currentPasswordField"
                           GridPane.columnIndex="1"
                           prefWidth="240"/>

            <Label text="New Password:" GridPane.rowIndex="1"/>
            <PasswordField fx:id="newPasswordField"
                           GridPane.rowIndex="1"
                           GridPane.columnIndex="1"
                           prefWidth="240"/>

            <Label text="Confirm Password:" GridPane.rowIndex="2"/>
            <PasswordField fx:id="confirmPasswordField"
                           GridPane.rowIndex="2"
                           GridPane.columnIndex="1"
                           prefWidth="240"/>

        </GridPane>

        <Label text="Tip: Use a password you can remember, but avoid simple values like 1234."
               wrapText="true"
               style="-fx-text-fill:#6b7280; -fx-font-size:12px;"/>
    </VBox>

    <HBox spacing="10" alignment="CENTER_RIGHT">
        <Button text="Cancel"
                onAction="#close"/>

        <Button text="Change Password"
                onAction="#changePassword"
                style="-fx-background-color:#2563eb; -fx-text-fill:white; -fx-font-weight:bold;"/>
    </HBox>

</VBox>