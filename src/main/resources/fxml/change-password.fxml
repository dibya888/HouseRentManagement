<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.rent.controller.ChangePasswordController"
      spacing="16"
      prefWidth="440"
      styleClass="popup-root"
      stylesheets="@/css/popups.css">

    <ImageView fitWidth="80" preserveRatio="true">
        <image>
            <Image url="@/images/app-logo.png" />
        </image>
    </ImageView>

    <Label text="🔐 Change Password"
           styleClass="popup-title"
           maxWidth="Infinity"
           alignment="CENTER"/>

    <VBox spacing="12" styleClass="popup-card">

        <GridPane hgap="14" vgap="12">

            <Label text="Current Password:"/>
            <PasswordField fx:id="currentPasswordField"
                           GridPane.columnIndex="1"
                           prefWidth="240"/>

            <Label text="New Password:" GridPane.rowIndex="1"/>
            <PasswordField fx:id="newPasswordField"
                           GridPane.rowIndex="1"
                           GridPane.columnIndex="1"
                           prefWidth="240"/>

            <Label text="Confirm Password:" GridPane.rowIndex="2"/>
            <PasswordField fx:id="confirmPasswordField"
                           GridPane.rowIndex="2"
                           GridPane.columnIndex="1"
                           prefWidth="240"/>

        </GridPane>

        <Label text="Tip: Use a password you can remember, but avoid simple values like 1234."
               wrapText="true"
               styleClass="popup-subtitle"/>
    </VBox>

    <HBox spacing="10" alignment="CENTER_RIGHT">
        <Button text="Cancel"
                onAction="#close"
                styleClass="popup-secondary-btn"/>

        <Button text="Change Password"
                onAction="#changePassword"
                styleClass="popup-primary-btn"/>
    </HBox>

</VBox>
