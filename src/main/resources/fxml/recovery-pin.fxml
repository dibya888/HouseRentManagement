<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.rent.controller.RecoveryPinController"
      spacing="16"
      prefWidth="460"
      styleClass="popup-root"
      stylesheets="@/css/popups.css">

    <ImageView fitWidth="80" preserveRatio="true">
        <image>
            <Image url="@/images/app-logo.png" />
        </image>
    </ImageView>

    <Label text="🔐 Set Recovery PIN"
           styleClass="popup-title"
           maxWidth="Infinity"
           alignment="CENTER"/>

    <VBox spacing="12" styleClass="popup-card">

        <Label text="Recovery PIN helps you reset your password if you forget it."
               wrapText="true"
               styleClass="popup-subtitle"/>

        <GridPane hgap="14" vgap="12">

            <Label text="Login Password:"/>
            <PasswordField fx:id="passwordField"
                           GridPane.columnIndex="1"
                           prefWidth="250"/>

            <Label text="Recovery PIN:" GridPane.rowIndex="1"/>
            <PasswordField fx:id="recoveryPinField"
                           GridPane.rowIndex="1"
                           GridPane.columnIndex="1"
                           prefWidth="250"/>

            <Label text="Confirm PIN:" GridPane.rowIndex="2"/>
            <PasswordField fx:id="confirmPinField"
                           GridPane.rowIndex="2"
                           GridPane.columnIndex="1"
                           prefWidth="250"/>

        </GridPane>

        <Label text="PIN must be 4 to 8 digits. Keep it private."
               wrapText="true"
               styleClass="popup-subtitle"/>

    </VBox>

    <HBox spacing="10" alignment="CENTER_RIGHT">
        <Button text="Cancel"
                onAction="#close"
                styleClass="popup-secondary-btn"/>

        <Button text="Save Recovery PIN"
                onAction="#saveRecoveryPin"
                styleClass="popup-primary-btn"/>
    </HBox>

</VBox>
