<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.rent.controller.ViewRentController"
            prefWidth="520"
            prefHeight="600"
            styleClass="popup-root"
            stylesheets="@/css/popups.css">

    <top>
        <Label fx:id="titleLabel"
               styleClass="popup-title"
               style="-fx-padding:20 20 0 20;"/>
    </top>

    <center>
        <ScrollPane fitToWidth="true"
                    style="-fx-background-color:transparent; -fx-background:transparent;">
            <content>
                <VBox spacing="18" style="-fx-padding:16 20 20 20;">

                    <!-- Main Card -->
                    <VBox spacing="18" styleClass="popup-card">

                        <!-- Basic Info -->
                        <VBox spacing="8">
                            <Label text="Basic Information"
                                   styleClass="popup-section-title"/>

                            <GridPane hgap="16" vgap="10">
                                <Label text="Flat No:"/>
                                <Label fx:id="flatNoLabel" GridPane.columnIndex="1"/>

                                <Label text="Tenant:" GridPane.rowIndex="1"/>
                                <Label fx:id="tenantNameLabel" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                                <Label text="Phone:" GridPane.rowIndex="2"/>
                                <Label fx:id="phoneLabel" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

                                <Label text="Bill Month:" GridPane.rowIndex="3"/>
                                <Label fx:id="billMonthLabel" GridPane.rowIndex="3" GridPane.columnIndex="1"/>
                            </GridPane>
                        </VBox>

                        <Separator/>

                        <!-- Bills -->
                        <VBox spacing="8">
                            <Label text="Bills Breakdown"
                                   styleClass="popup-section-title"/>

                            <GridPane hgap="16" vgap="10">
                                <Label text="House Rent:"/>
                                <Label fx:id="houseRentLabel" GridPane.columnIndex="1"/>

                                <Label text="Electricity:" GridPane.rowIndex="1"/>
                                <Label fx:id="electricityLabel" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                                <Label text="Water:" GridPane.rowIndex="2"/>
                                <Label fx:id="waterLabel" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

                                <Label text="Gas:" GridPane.rowIndex="3"/>
                                <Label fx:id="gasLabel" GridPane.rowIndex="3" GridPane.columnIndex="1"/>

                                <Label text="Other Bills:" GridPane.rowIndex="4"/>
                                <Label fx:id="otherBillsLabel" GridPane.rowIndex="4" GridPane.columnIndex="1"/>

                                <Label text="Fine:" GridPane.rowIndex="5"/>
                                <Label fx:id="fineLabel" GridPane.rowIndex="5" GridPane.columnIndex="1"/>

                                <Label text="Discount:" GridPane.rowIndex="6"/>
                                <Label fx:id="discountLabel" GridPane.rowIndex="6" GridPane.columnIndex="1"/>
                            </GridPane>
                        </VBox>

                        <Separator/>

                        <!-- Summary -->
                        <HBox spacing="20" alignment="CENTER_LEFT">
                            <VBox>
                                <Label text="Total"
                                       styleClass="popup-subtitle"/>
                                <Label fx:id="totalLabel"
                                       style="-fx-font-size:18px; -fx-font-weight:bold;"/>
                            </VBox>

                            <Region HBox.hgrow="ALWAYS"/>

                            <VBox alignment="CENTER_LEFT">
                                <Label text="Status"
                                       styleClass="popup-subtitle"/>
                                <Label fx:id="statusLabel"
                                       style="-fx-font-size:14px; -fx-font-weight:bold;"/>
                            </VBox>
                        </HBox>

                    </VBox>

                </VBox>
            </content>
        </ScrollPane>
    </center>

    <!-- Footer -->
    <bottom>
        <HBox alignment="CENTER_RIGHT"
              style="-fx-padding:0 20 20 20;">
            <Button text="Close"
                    onAction="#close"
                    styleClass="popup-secondary-btn"/>
        </HBox>
    </bottom>

</BorderPane>
