<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.rent.controller.UserManagementController"
      spacing="16"
      prefWidth="900"
      prefHeight="560"
      style="-fx-padding:20; -fx-background-color:#f4f6f7;">

    <!-- Header -->
    <VBox spacing="4">
        <Label text="User Management"
               style="-fx-font-size:24px; -fx-font-weight:bold; -fx-text-fill:#111827;"/>

        <Label text="Manage application users. Each user has a separate secure database."
               wrapText="true"
               style="-fx-font-size:13px; -fx-text-fill:#6b7280;"/>
    </VBox>

    <!-- Actions -->
    <HBox spacing="10" alignment="CENTER_RIGHT">
        <Button fx:id="addUserButton"
                text="Add User"
                onAction="#addUser"
                styleClass="settings-primary-btn"/>

        <Button fx:id="refreshButton"
                text="Refresh"
                onAction="#refreshUsers"
                styleClass="settings-primary-btn"/>
    </HBox>

    <!-- User Table -->
    <TableView fx:id="usersTable"
               VBox.vgrow="ALWAYS">

        <columns>
            <TableColumn fx:id="usernameColumn"
                         text="Username"
                         prefWidth="130"/>

            <TableColumn fx:id="displayNameColumn"
                         text="Display Name"
                         prefWidth="150"/>

            <TableColumn fx:id="roleColumn"
                         text="Role"
                         prefWidth="100"/>

            <TableColumn fx:id="statusColumn"
                         text="Status"
                         prefWidth="100"/>

            <TableColumn fx:id="createdAtColumn"
                         text="Created At"
                         prefWidth="160"/>

            <TableColumn fx:id="lastLoginColumn"
                         text="Last Login"
                         prefWidth="160"/>
        </columns>
    </TableView>

    <!-- Footer -->
    <HBox alignment="CENTER_RIGHT">
        <Button fx:id="closeButton"
                text="Close"
                onAction="#closeWindow"
                styleClass="settings-primary-btn"/>
    </HBox>

</VBox>